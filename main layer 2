<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Pokédex</title>

<style>
    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: #111;
        color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .pokedex-container {
        background: #1a1a1a;
        border: 3px solid #ff0000;
        border-radius: 16px;
        padding: 30px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 0 25px rgba(255, 0, 0, 0.4);
        text-align: center;
    }

    h1 {
        font-size: 2.4rem;
        margin-bottom: 20px;
        color: #ff4d4d;
        text-shadow: 0 0 10px rgba(255, 0, 0, 0.6);
    }

    @keyframes blink {
        0% { opacity: 1; }
        50% { opacity: 0; }
        100% { opacity: 1; }
    }

    input::placeholder {
        animation: blink 1.2s infinite;
    }

    input {
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        border: 2px solid #ff4d4d;
        background: #222;
        color: white;
        font-size: 1rem;
        outline: none;
        margin-bottom: 15px;
    }

    button {
        width: 100%;
        padding: 12px;
        background: #ff0000;
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 1.1rem;
        cursor: pointer;
        transition: 0.25s;
        margin-bottom: 10px;
        box-shadow: 0 0 0 rgba(255, 0, 0, 0);
    }

    button:hover {
        background: #cc0000;
        box-shadow: 0 0 15px rgba(255, 0, 0, 0.8);
    }

    #results {
        margin-top: 25px;
        padding: 20px;
        background: #222;
        border-radius: 12px;
        border: 2px solid #444;
        min-height: 120px;
    }

    /* Type badge styles */
    .type-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 12px;
        color: #fff;
        font-weight: bold;
        margin: 4px;
        text-transform: capitalize;
    }

    .fire { background: #f08030; }
    .water { background: #6890f0; }
    .grass { background: #78c850; }
    .electric { background: #f8d030; color: #000; }
    .ice { background: #98d8d8; color: #000; }
    .fighting { background: #c03028; }
    .poison { background: #a040a0; }
    .ground { background: #e0c068; color: #000; }
    .flying { background: #a890f0; }
    .psychic { background: #f85888; }
    .bug { background: #a8b820; color: #000; }
    .rock { background: #b8a038; color: #000; }
    .ghost { background: #705898; }
    .dragon { background: #7038f8; }
    .dark { background: #705848; }
    .steel { background: #b8b8d0; color: #000; }
    .fairy { background: #ee99ac; }
</style>
</head>

<body>
<div class="pokedex-container">
    <h1>Pokédex 🔴⚪</h1>

    <input id="pokemonInput" type="text" placeholder="Enter Pokémon name...">
    <button onclick="searchPokemon()">Search</button>
    <button onclick="randomPokemon()">Random Pokémon</button>

    <div id="results"></div>
</div>

<script>
async function fetchPokemon(identifier) {
    const results = document.getElementById("results");
    results.innerHTML = "<p>Loading...</p>";

    try {
        const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${identifier}`);

        if (!response.ok) {
            results.innerHTML = "<p>Pokémon not found! Try another name.</p>";
            return;
        }

        const data = await response.json();

        const name = data.name.charAt(0).toUpperCase() + data.name.slice(1);
        const sprite = data.sprites.front_default;

        const typesHTML = data.types
            .map(t => `<span class="type-badge ${t.type.name}">${t.type.name}</span>`)
            .join("");

        const hp = data.stats.find(s => s.stat.name === "hp").base_stat;
        const attack = data.stats.find(s => s.stat.name === "attack").base_stat;
        const defense = data.stats.find(s => s.stat.name === "defense").base_stat;

        const height = (data.height / 10).toFixed(1); // meters
        const weight = (data.weight / 10).toFixed(1); // kg

        results.innerHTML = `
            <h2>${name}</h2>
            <img src="${sprite}" alt="${name}">
            <div>${typesHTML}</div>
            <p><strong>Height:</strong> ${height} m</p>
            <p><strong>Weight:</strong> ${weight} kg</p>
            <p><strong>HP:</strong> ${hp}</p>
            <p><strong>Attack:</strong> ${attack}</p>
            <p><strong>Defense:</strong> ${defense}</p>
        `;
    } catch {
        results.innerHTML = "<p>Something went wrong. Please try again.</p>";
    }
}

function searchPokemon() {
    const name = document.getElementById("pokemonInput").value.trim().toLowerCase();
    if (name) fetchPokemon(name);
}

function randomPokemon() {
    const randomId = Math.floor(Math.random() * 1010) + 1;
    fetchPokemon(randomId);
}
</script>

</body>
</html>
